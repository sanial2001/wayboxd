# Copy to `.env.local` and adjust values.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/wayboxd"

NEXTAUTH_SECRET="generate-a-secret-for-local-dev"

# Photon OSM search (server-side place picker)
PHOTON_BASE_URL="https://photon.komoot.io"
PHOTON_USER_AGENT="Wayboxd/1.0"

# Optional: trace | debug | info | warn | error | fatal (defaults: info in production, debug otherwise)
# LOG_LEVEL="debug"

# Vercel Blob (profile avatars). Pull from Vercel with `npx vercel env pull .env.local`.
# BLOB_STORE_ID=""
# BLOB_READ_WRITE_TOKEN=""

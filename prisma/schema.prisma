// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int       @id @default(autoincrement())
  email             String?   @map("email")
  username          String    @unique @map("username")
  password          String    @map("password")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime? @map("updated_at")

  createdPlaces     Place[]   @relation("PlaceCreator")
  reviews           Review[]  @relation("ReviewAuthor")

  @@index([username])
  @@map("users")
}

model Place {
  id              Int           @id @default(autoincrement())
  slug            String        @unique @map("slug")
  name            String        @map("name")
  description     String?       @map("description")
  category        String        @map("category")
  parentPlaceId   Int?          @map("parent_place_id")
  parent          Place?        @relation("PlaceHierarchy", fields: [parentPlaceId], references: [id])
  children        Place[]       @relation("PlaceHierarchy")
  externalSource  String?       @map("external_source")
  externalId      String?       @map("external_id")
  city            String        @map("city")
  region          String?       @map("region")
  country         String        @map("country")
  latitude        Decimal?      @map("latitude") @db.Decimal(9, 6)
  longitude       Decimal?      @map("longitude") @db.Decimal(9, 6)
  address         String?       @map("address")
  coverImageUrl   String?       @map("cover_image_url")
  createdByUserId Int?          @map("created_by_user_id")
  createdBy       User?         @relation("PlaceCreator", fields: [createdByUserId], references: [id])
  reviews         Review[]
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime?     @map("updated_at")

  @@unique([externalSource, externalId])
  @@index([city, country])
  @@index([category])
  @@index([parentPlaceId])
  @@map("places")
}

model Review {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  placeId      Int       @map("place_id")
  title        String    @map("title")
  body         String?   @map("body")
  rating       Int       @map("rating")
  wouldGoAgain Boolean?  @map("would_go_again")
  visitDate    DateTime? @map("visit_date")
  tags         String[]  @map("tags")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @map("updated_at")

  user         User      @relation("ReviewAuthor", fields: [userId], references: [id])
  place        Place     @relation(fields: [placeId], references: [id])

  @@unique([userId, placeId])
  @@index([placeId])
  @@index([userId])
  @@map("reviews")
}
